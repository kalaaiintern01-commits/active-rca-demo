# Whole capstone project: firmware, bridge, training, dashboard (active-rca-demo/site, published
# to GitHub Pages by .github/workflows/pages.yml) and the paper.

# Per-recording dataset CSVs (4.7 GB) stay local - sources and how to rebuild them in data/README.md
data/S1_paderborn_pmsm/
data/S2_cubemars_pmsm/
data/S3_cartif_dc_motor/
data/raw/
data/extracted/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env
*secrets*
config.local.h

# PlatformIO build tree: keep only the built firmware that wokwi.toml points at
**/.pio/*
!**/.pio/build/
**/.pio/build/*
!**/.pio/build/esp32dev/
**/.pio/build/esp32dev/*
!**/.pio/build/esp32dev/firmware.bin
!**/.pio/build/esp32dev/firmware.elf

# Tool scratch output
.playwright-mcp/

# npm dependencies (rebuilt from package-lock.json)
node_modules/
